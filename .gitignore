__pycache__/
*.pyc
*.pyo
.DS_Store
.claude/settings.local.json

# Python virtualenv
.venv/

# API keys and sensitive data
.env
env-data.json

# Raw capture data (HAR, Coverage): never versioned.
# An authenticated journey HAR can contain credentials, session tokens or
# personal data. The pattern covers all audit cases, present and future, at
# any depth.
raw-data-potentially-sensitive/

# Raw archive of the HTML/CSS re-downloaded by parse_html_criteria.py (work item
# 27), one copy per page/stylesheet to replay the analysis offline.
# Raw capture of a third-party site, not a report artifact: same logic as
# raw-data-potentially-sensitive/ above, at any depth under audits/.
html-pages/

# e-footprint outputs (generated, not versioned)
efootprint-python-summary.json
efootprint-boavizta-model.json
efootprint-scenario-*.e-f.json
efootprint-recommendations-gains.json
topology-*.puml
topology-*.svg
topology-*.pdf

# Generated HTML reports
journey-report-*.html
har-analysis.json
coverage-analysis.json

# Core Web Vitals: output generated by collect_cwv_pagespeed.py, consistent with
# the other e-footprint/report outputs above (never covered by a rule before
# 28/08/2026: a simple oversight, not a deliberate choice).
cwv.json

# Backup copies left by a tool or an agent before editing. The pattern
# covers *.bak, *.bak2, *.bak.2026-09-04, etc. They are redundant: the
# original is always recoverable via `git show HEAD:<path>`.
*.bak*

# Internal analysis files
.analysis_start
.cost-start-ts
.cost-session-id

# Temporary working area: handoffs between sessions, experimentation scripts,
# frozen baselines, reading notes. Nothing here is a deliverable.
tmp/

# Documentation drafts in progress: not deliverables yet.
documentation/in-progress/

# Claude Code settings file with a space in the name
.claude/ .json

# Scope notes specific to a given audit (traffic figures, business data of the
# audited site): same logic as the rest of audits/*, never versioned.
SCOPE-CAPTURE.md

# Unversioned working directories
audits/
documentation/internal-information/
