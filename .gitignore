__pycache__/
*.pyc
*.pyo
.DS_Store
.claude/settings.local.json

# Python virtualenv
.venv/

# Clés API et données sensibles
.env
env-data.json

# Données brutes de capture (HAR, Coverage) : jamais versionnées.
# Un HAR de parcours authentifié peut contenir des identifiants, des jetons de
# session ou des données personnelles. Le motif couvre tous les cas d'audit,
# présents et futurs, à n'importe quelle profondeur.
donnees-brutes-potentiellement-sensibles/

# Archive brute du HTML/CSS retéléchargé par parse_html_criteria.py (chantier
# 27), une copie par page/feuille de style pour rejouer l'analyse hors ligne.
# Capture brute d'un site tiers, pas un artefact du rapport : même logique que
# donnees-brutes-potentiellement-sensibles/ ci-dessus, à n'importe quelle
# profondeur sous audits/.
pages-html/

# Outputs e-footprint (générés, non versionnés)
efootprint-synthese-python.json
efootprint-boavizta-model.json
topologie-*.puml
topologie-*.svg
topologie-*.pdf

# Rapports HTML générés
rapport-parcours-*.html
har-analysis.json
coverage-analysis.json

# Core Web Vitals : output généré par collect_cwv_pagespeed.py, cohérence avec
# les autres outputs e-footprint/rapport ci-dessus (jamais couvert par une
# règle avant le 28/08/2026 : simple oubli, pas un choix délibéré).
cwv.json

# Copies de sauvegarde laissees par un outil ou un agent avant edition. Le motif
# couvre *.bak, *.bak2, *.bak.2026-09-04, etc. Elles sont redondantes : l'original
# est toujours recuperable par `git show HEAD:<chemin>`.
*.bak*

# Fichiers internes analyse
.analysis_start
.cost-start-ts
.cost-session-id

# Zone de travail temporaire : handoffs entre sessions, scripts d'expérimentation,
# baselines figées, notes de lecture. Rien ici n'est un livrable.
tmp/

# Brouillons de documentation en cours de rédaction : pas encore des livrables.
documentation/en cours/

# Fichier settings Claude Code avec espace dans le nom
.claude/ .json

# Notes de perimetre propres a un audit precis (chiffres de trafic, donnees
# metier du site audite) : meme logique que le reste d'audits/*, jamais versionne.
PERIMETRE-CAPTURE.md
