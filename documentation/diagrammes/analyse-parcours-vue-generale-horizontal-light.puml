@startuml analyse-parcours-vue-generale-horizontal-light
' DO NOT regenerate the .svg/.pdf of this diagram with `plantuml -tsvg`: this
' file only documents the CONTENT (texts, logical order). The real rendering
' (2 columns, REPORT aligned at the top with COLLECTION, U-shaped connector) is
' hand-built in the .svg of the same name - PlantUML (activity beta) cannot
' produce this layout without inverting the column order
' (tested on 2026-09-16, 5 different approaches, same limit every time).
' If the content changes here, port the same text change into the .svg.
' Detailed manual capture procedure (MANUAL CAPTURE block below):
' .claude/skills/analyse-parcours/docs/capture-har-and-coverage.md
title Web journey analysis — Workflow overview (by theme, compact version)

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #E0F0F4
  BorderColor #5BA1BC
  FontColor #1C2856
  DiamondBackgroundColor #E0F0F4
  DiamondBorderColor #5BA1BC
}
skinparam ArrowColor #5BA1BC
skinparam ActivityBarColor #5BA1BC
skinparam NoteBackgroundColor #E0F0F4
skinparam NoteBorderColor #9BD0DD
skinparam PartitionBackgroundColor #ECECF2
skinparam PartitionBorderColor #5BA1BC

partition "**MANUAL CAPTURE** (prerequisite, human, outside the skill)" #9BD0DD {
  (*) --> "Network : Preserve log + Disable cache\nFull journey, cookies accepted\n-> 'Save all as HAR with content' (.har)" as M1
  M1 -down-> "Coverage panel (Cmd+Shift+P)\nRecord, reload, scroll\n-> export JSON per page (Coverage-*.json)" as M2
}

partition "**COLLECTION** (automatic)" {
  M2 -down-> "HAR, Coverage, Core Web Vitals\n(analyze_har.py, coverage_metrics.py,\ncollect_cwv_pagespeed.py or run_lighthouse.sh as fallback)" as C1
}

partition "**AUTOMATIC EOF JUDGMENT** (automatic)" {
  C1 -down-> "run_eof.py compares the already\ncollected data against the EOF reference\n(~10 criteria out of 54 settled by script,\nthe rest stays 'I don't know')" as J1
}

partition "**CO2e IMPACT** (optional, at any time)" #9BD0DD {
  J1 -down-> "/efootprint -> Boavizta model (reference\n+ 3 cumulative scenarios prio1 / prio1+2 / prio1+2+3)\n-> data available for the NEXT\nreport generation, not an isolated final add-on" as I1
  I1 -down-> "Possible human action: annual traffic and\ncloud instance size, if not auto-detected" as I2
}

partition "**REPORT — first generation** (automatic)" {
  I2 -down-> "generate_report_html.py\n(+ check_report_values.py, internal\nnon-blocking check)\n-> already contains the automatic EOF judgment\n(partial) and the CO2e if already calculated" as R1
}

partition "**EOF QUESTIONNAIRE** (manual, mission decision)" #9BD0DD {
  R1 -down-> "When: after the automatic judgment,\nonly on the criteria left\n'I don't know' - never before,\nnever triggered on its own" as Q1
  Q1 -down-> "generate_questionnaire.py -> file to fill in\n(questionnaire-eof.md), sent to the client,\nfilled in, read back (parse_questionnaire.py),\nmerged (merge_lots.py) according to the\nprecedence collected > estimated > stated\n> declared > assumed" as Q2
}

partition "**REPORT — regeneration** (automatic)" {
  Q2 -down-> "generate_report_html.py\n-> reflects the merged questionnaire answers\n(+ CO2e if calculated meanwhile)" as R2
}

R2 --> (*)

@enduml
