@startuml analyse-parcours-vue-generale-horizontal-light
title Analyse de parcours web — Vue generale du workflow (par thematique)-horizontal-light

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #E0F0F4
  BorderColor #5BA1BC
  FontColor #1C2856
  DiamondBackgroundColor #E0F0F4
  DiamondBorderColor #5BA1BC
}
skinparam ArrowColor #5BA1BC
skinparam ActivityBarColor #5BA1BC
skinparam NoteBackgroundColor #E0F0F4
skinparam NoteBorderColor #9BD0DD
skinparam PartitionBackgroundColor #ECECF2
skinparam PartitionBorderColor #5BA1BC

partition "**COLLECTE** (automatique)" {
  (*) --> "HAR, Coverage, Core Web Vitals\n(analyze_har.py, coverage_metrics.py,\ncollect_cwv_pagespeed.py ou run_lighthouse.sh en repli)" as C1
}

note right #ECECF2
  **Legende**
  Fond gris pale : automatique
  (calcul machine, aucune action humaine)
end note

note right #9BD0DD
  Fond bleu clair : action humaine requise
  (saisie, decision, ou reponse d'un tiers externe)
end note

partition "**JUGEMENT AUTOMATIQUE EOF** (automatique)" {
  C1 -right-> "run_eof.py confronte les donnees\ndeja collectees au referentiel EOF\n(~10 criteres sur 54 tranches par script,\nle reste reste 'je ne sais pas')" as J1
}

partition "**IMPACT CO2e** (optionnel, a tout moment)" #9BD0DD {
  J1 -right-> "/efootprint -> modele Boavizta (reference\n+ 3 scenarios cumules prio1 / prio1+2 / prio1+2+3)\n-> donnees disponibles pour la PROCHAINE\ngeneration du rapport, pas un ajout final isole" as I1
  I1 --> "Action humaine possible : trafic annuel et\ntaille d'instance cloud, si non auto-detectes" as I2
}

partition "**RAPPORT — premiere generation** (automatique)" {
  I2 -right-> "generate_report_html.py\n(+ check_valeurs_rapport.py, controle\ninterne non bloquant)\n-> contient deja le jugement EOF automatique\n(partiel) et le CO2e si deja calcule" as R1
}

partition "**QUESTIONNAIRE EOF** (manuel, decision de mission)" #9BD0DD {
  R1 -right-> "Quand : apres le jugement automatique,\nuniquement sur les criteres restes\n'je ne sais pas' - jamais avant,\njamais declenche seul" as Q1
  Q1 --> "generate_questionnaire.py -> fichier a remplir\n(questionnaire-eof.md), envoye au client,\nrempli, relu (parse_questionnaire.py),\nfusionne (fusionner_lots.py) selon la\nprecedence collecte > estime > precise\n> declare > suppose" as Q2
}

partition "**RAPPORT — regeneration** (automatique)" {
  Q2 -right-> "generate_report_html.py\n-> reflete les reponses du questionnaire\nfusionnees (+ CO2e si calcule entre-temps)" as R2
}

R2 --> (*)

@enduml
