google.visualization.Query.setResponse({"version":"0.6","reqId":"0","status":"ok","sig":"1075859009","table":{"cols":[{"id":"A","label":"","type":"string"},{"id":"B","label":"","type":"string"},{"id":"C","label":"","type":"string"},{"id":"D","label":"","type":"string"},{"id":"E","label":"","type":"string"},{"id":"F","label":"","type":"string"},{"id":"G","label":"","type":"string"},{"id":"H","label":"","type":"string"},{"id":"I","label":"","type":"number","pattern":"General"},{"id":"J","label":"","type":"number","pattern":"General"},{"id":"K","label":"","type":"number","pattern":"General"},{"id":"L","label":"","type":"string"},{"id":"M","label":"","type":"string"}],"rows":[{"c":[null,null,{"v":"🛖 Product"},null,null,{"v":"Optimization potential"},null,null,{"v":5.0,"f":"5"},{"v":23.5,"f":"23,5"},{"v":6.5,"f":"6,5"},null,{"v":null}]},{"c":[null,null,{"v":"Identify the best optimization opportunities."},null,null,{"v":"28%"},null,null,null,null,null,null,{"v":null}]},{"c":[null,null,null,null,null,{"v":"A higher score reflects greater optimization potential."},null,null,null,null,null,null,{"v":null}]},{"c":[null,{"v":"ID"},{"v":"CRITERION"},{"v":"ADDITIONAL EXPLANATION"},{"v":"✏️ EVALUATION"},{"v":"EVALUATION METHODS"},{"v":"IMPACT LEVEL"},null,null,null,null,null,{"v":null}]},{"c":[null,{"v":"1.1"},{"v":"Is there a simple way to perform this action?"},{"v":"If there is already a way to do it, does the digital approach bring added value to the user?"},{"v":"✅ Confirmed strength"},{"v":"The criterion is met if:\nThe team has identified a simpler non-digital or existing solution and shown that the digital version clearly adds value compared to it (time savings, accessibility, reduced hardware impact)."},{"v":"Decisive"},null,{"v":0.0,"f":"0"},{"v":2.0,"f":"2"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.2"},{"v":"Are the target users — with their business needs, typical devices, and ergonameics expectations — well known?"},{"v":"The product risks being poorly designed if the target users are not well known, or better still, involved in the project. For example, user journeys could be cumbersome or the compatibility strategy inadequate."},{"v":"💡 Improvement potential identified"},{"v":"The criterion is met if:\nUser needs and contexts are documented using personas, interviews, and usage analyses, and common devices are well known and taken into account in the design."},{"v":"Decisive"},null,{"v":1.0,"f":"1"},{"v":2.0,"f":"2"},{"v":2.0,"f":"2"},null,{"v":null}]},{"c":[null,{"v":"1.3"},{"v":"Are updates of new features mandatory on all devices, regardless of operating system or browser?"},{"v":"New features weigh down the application. On older devices, users may prefer to keep a simpler, more performant, less resource-hungry product."},{"v":"🚫 Not applicable"},{"v":"The criterion is met if:\nTests show that the update does not degrade performance on older or modest devices, and that the product offers optional or lightweight modes when needed."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.4"},{"v":"Does the design include custom components rather than native ones?"},{"v":"System components (buttons, menus, forms, etc.) are almost always more efficient than custom-built ones — not to mention their accessibility and compatibility."},{"v":"💡 Improvement potential identified"},{"v":"The criterion is met if:\nNative components are preferred or justified; custom components are used only when necessary and offer performance and accessibility equivalent or superior to native components."},{"v":"Moderate"},null,{"v":1.0,"f":"1"},{"v":1.0,"f":"1"},{"v":1.0,"f":"1"},null,{"v":null}]},{"c":[null,{"v":"1.5"},{"v":"Are there animations, videos, sounds, maps (...) that play automatically?"},{"v":"Playing this kind of content without any user action is disruptive and uses resources such as bandwidth and the graphics processor."},{"v":"💡 Improvement potential identified"},{"v":"The criterion is met if:\nNo media plays without user action, or autoplay is technically necessary and optimized (lightweight, disabled by default, user-controlled)."},{"v":"Moderate"},null,{"v":1.0,"f":"1"},{"v":1.0,"f":"1"},{"v":1.0,"f":"1"},null,{"v":null}]},{"c":[null,{"v":"1.6"},{"v":"Can the resources used by the application be adapted to the user\u0027s hardware configuration?"},{"v":"Not everyone has a device capable of running resource-intensive content (such as multimedia, etc.).\nWhat happens when a user tries to run resource-intensive content on an unsuitable device? Ideally, the service should not block access and should run the basic functions."},{"v":"💡 Improvement potential identified"},{"v":"The criterion is met if:\nThe application detects limited hardware conditions and automatically switches to lighter behaviors (reduced quality, simplified rendering, heavy processes disabled)."},{"v":"Moderate"},null,{"v":1.0,"f":"1"},{"v":1.0,"f":"1"},{"v":1.0,"f":"1"},null,{"v":null}]},{"c":[null,{"v":"1.7"},{"v":"Are all features useful, usable, and used?"},{"v":"Simplifying the product by removing unused features will reduce resource consumption."},null,{"v":"The criterion is met if:\nUsage data (analytics, logs, comments) shows that each feature is actually used and provides obvious added value, and that unused or redundant features are identified and removed to reduce resource consumption."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.8"},{"v":"Is application support poor on the oldest targeted devices?"},{"v":"Most of the impact of digital services is felt on client devices. It is very important not to push these devices into obsolescence by breaking their compatibility."},null,{"v":"The criterion is met if:\nThe application works correctly on the oldest devices in the target group, without imposing unnecessary upgrades or causing performance issues that accelerate obsolescence."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.9"},{"v":"Does using the application require a high-speed network?"},{"v":"High bandwidth implies significant resource use. This indicates that optimizations are possible to reduce the number and/or size of requests."},{"v":"💡 Improvement potential identified"},{"v":"The criterion is met if:\nThe application remains usable on low-bandwidth connections, through optimized requests, reduced multimedia file sizes, caching strategies, or a lightweight mode."},{"v":"Significant"},null,{"v":1.0,"f":"1"},{"v":1.5,"f":"1,5"},{"v":1.5,"f":"1,5"},null,{"v":null}]},{"c":[null,{"v":"1.10"},{"v":"Does the product use manipulative designs (UX dark patterns) that increase resource use?"},{"v":"Bad user-experience practices include infinite scrolling, pre-checked subscriptions, difficulty unsubscribing, etc."},null,{"v":"The criterion is met if:\nNo deceptive pattern is present and the design avoids mechanisms such as infinite scrolling, forced autoplay, or hidden unsubscribe flows that artificially increase page load and data use."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.11"},{"v":"Can the default values (number of items displayed, quality, refresh rate, etc.) be changed to reduce resource use?"},{"v":"Users generally do not change default values. Setting more frugal defaults can reduce resource consumption."},null,{"v":"The criterion is met if:\nDefault values are set to resource-efficient options, and users can easily adjust settings (quality, number of displays, frequency) to more demanding modes only if necessary."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.12"},{"v":"Are there many trackers on the product?"},{"v":"Marketing analytics and tracking tools are often responsible for more than a third of requests on websites. Limiting the number of tools and partners would reduce resource use and improve privacy."},null,{"v":"The criterion is met if:\nTracking is strictly limited to what is necessary, the number of trackers/tools is kept to a minimum, and each tracking request is justified. Removing unnecessary trackers reduces network load and improves privacy."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.13"},{"v":"Are the main user journeys optimized to be smooth and efficient?"},{"v":"Efficient user journeys with few screens reduce resource use and improve user satisfaction and productivity."},null,{"v":"The criterion is met if:\nThe main workflows require a minimal number of steps/screens, without redundant navigation, which improves efficiency and reduces the number of server or client requests."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.14"},{"v":"Are the main screens clear and well designed?"},{"v":"The most-used screens must be light in terms of displayed information and media, in order to reduce resource use."},null,{"v":"The criterion is met if:\nThe most frequently used screens contain only the necessary information, use lightweight media, and avoid heavy scripts or components that increase rendering cost."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.15"},{"v":"Is this service used frequently?"},{"v":"A rarely used service that runs continuously can have an unnecessary environmental impact.\nConversely, a frequently used service justifies its resource consumption.\nUnderstanding usage frequency helps assess whether the service should stay as is, be simplified, be partially decommissioned, or move to on-demand execution."},{"v":"✅ Confirmed strength"},{"v":"The criterion is met if the service shows regular, significant usage, in line with its resource footprint."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.16"},{"v":"Volume (number of users)"},{"v":"Knowing the number of active users helps put the environmental impact into context and determine whether the scale of the service matches its actual audience.\nA large infrastructure serving a small population may indicate over-provisioning, while high usage can fully justify the allocated resources."},null,{"v":"The criterion is met if the product\u0027s user volume justifies its resource use and architecture."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[{"v":"Licence CC-BY-SA"},null,null,null,null,null,null,null,null,null,null,null,{"v":null}]}],"parsedNumHeaders":1}});