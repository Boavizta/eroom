google.visualization.Query.setResponse({"version":"0.6","reqId":"0","status":"ok","sig":"1454842464","table":{"cols":[{"id":"A","label":"","type":"string"},{"id":"B","label":"","type":"string"},{"id":"C","label":"","type":"string"},{"id":"D","label":"","type":"string"},{"id":"E","label":"","type":"string"},{"id":"F","label":"","type":"string"},{"id":"G","label":"","type":"string"},{"id":"H","label":"","type":"string"},{"id":"I","label":"","type":"number","pattern":"General"},{"id":"J","label":"","type":"number","pattern":"General"},{"id":"K","label":"","type":"number","pattern":"General"},{"id":"L","label":"","type":"string"},{"id":"M","label":"","type":"string"}],"rows":[{"c":[null,null,{"v":"🛖 Product"},null,null,{"v":"Potential of optimization"},null,null,{"v":0.0,"f":"0"},{"v":23.5,"f":"23,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,null,{"v":"Spot the best optimisation opportunities."},null,null,{"v":"0%"},null,null,null,null,null,null,{"v":null}]},{"c":[null,null,null,null,null,{"v":"A higher score reflects more optimisation potential."},null,null,null,null,null,null,{"v":null}]},{"c":[null,{"v":"ID"},{"v":"CRITERIA"},{"v":"ADDITIONAL EXPLANATION"},{"v":"✏️ EVALUATION"},{"v":"WAYS OF EVALUATION"},{"v":"LEVEL OF IMPACT"},null,null,null,null,null,{"v":null}]},{"c":[null,{"v":"1.1"},{"v":"Is there a low tech way exist to achieve this action ?"},{"v":"If there\u0027s already a way to do it, does a digital way add value to the user ?"},null,{"v":"The criterion is validated if:\nThe team has identified a simpler non-digital or existing solution and demonstrated that the digital version clearly adds value compared to it (time saved, accessibility, reduced material impact)."},{"v":"Decisive"},null,{"v":0.0,"f":"0"},{"v":2.0,"f":"2"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.2"},{"v":"Are the target users, with there business needs, typical devices and ergonomy expectations, well known ?"},{"v":"The product may not be well designed if the target users are not well known, or better, involved in the projet. For instance, the user journeys might be cumbersome or the compatibility strategy might be inadequate."},null,{"v":"The criterion is validated if:\nUser needs and contexts are documented through personas, interviews, usage analytics, and typical devices are well known and considered in the design."},{"v":"Decisive"},null,{"v":0.0,"f":"0"},{"v":2.0,"f":"2"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.3"},{"v":"Are the new features updates mandatory for all devices, with no relation to their operating system or browser ?"},{"v":"New features makes the application heavier. On older devices, users may prefer to keep the product simpler, with better performances and less resources used."},null,{"v":"The criterion is validated if:\nTests show that the update does not degrade performance on older or modest devices, and the product offers optional or lighter modes when needed."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.4"},{"v":"Does the design include custom made components instead of native ones ?"},{"v":"System components (buttons, menu, forms, ...) are almost always more efficient than custom made ones. Not to mention accessible and compatible."},null,{"v":"The criterion is validated if:\nNative components are preferred or justified; custom components are used only when necessary and show equal or better performance and accessibility than native ones."},{"v":"Moderate"},null,{"v":0.0,"f":"0"},{"v":1.0,"f":"1"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.5"},{"v":"Is there animations, videos, sounds, maps (\u2026) that are played automatically ?"},{"v":"Playing this type of content without any user action is annoying and uses resources like bandwidth and gpu."},null,{"v":"The criterion is validated if:\nNo media is launched without user action, or auto-play is technically required and optimised (lightweight, muted by default, user-controlled)."},{"v":"Moderate"},null,{"v":0.0,"f":"0"},{"v":1.0,"f":"1"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.6"},{"v":"Is it possible to adapt the resources used by the application to the user\u0027s hardware configuration ?"},{"v":"Not everyone has a device capable of running computationally intensive content (like multimedia content, etc.).\nWhat happens if a user tries to run computationally intensive content on an inappropriate device? In this case, ideally, the service should not be blocking and should perform basic functions.\n"},null,{"v":"The criterion is validated if:\nThe application detects limited hardware conditions and automatically switches to lighter behaviours (reduced quality, simplified rendering, disabled heavy processes)."},{"v":"Moderate"},null,{"v":0.0,"f":"0"},{"v":1.0,"f":"1"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.7"},{"v":"Are all features useful, usable and used ?"},{"v":"Simplifying the product by removing unused features will result in less resources used."},null,{"v":"The criterion is validated if:\nUsage data (analytics, logs, feedback) shows that each feature is actually used and provides clear value, and unused or redundant features are identified and removed to reduce resource consumption."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.8"},{"v":"Is the application support poor on the oldest devices targeted ?"},{"v":"Most of the impacts of digital services are on the client devices side. Not pushing these devices to obsolescence by breaking compatibility is very important."},null,{"v":"The criterion is validated if:\nThe application runs correctly on the oldest devices in the target group, without forcing unnecessary upgrades or causing performance issues that accelerate obsolescence."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.9"},{"v":"Is a high bandwidth network required to use the application ?"},{"v":"Requiring high bandwidth means that there\u0027s a lot resource use. It indicates that some optimisations are possible to reduce the number and/or the size of requets."},null,{"v":"The criterion is validated if:\nThe application remains usable on low-bandwidth connections, with optimised requests, reduced media sizes, caching strategies or a lightweight mode."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.10"},{"v":"Does the product uses UX dark patterns that increase resource use ?"},{"v":"UX dark patterns includes infinite scroll, prechecked subscriptions, making unsuscribtion difficult, etc."},null,{"v":"The criterion is validated if:\nNo dark patterns are present, and the design avoids mechanisms like infinite scroll, forced autoplay, or hidden unsubscribe flows that artificially increase page loads and data usage."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.11"},{"v":"Is it possible to change default values (number of elements displayed, quality, refresh frequency, ...) to reduce resource use ?"},{"v":"Users usually don\u0027t change the default values. Setting more sober default may result in less resources used."},null,{"v":"The criterion is validated if:\nDefault values are set to sober, resource-efficient options, and users can easily adjust parameters (quality, display count, frequency) toward more demanding modes only if needed."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.12"},{"v":"Is there a lot of tracking on the product ?"},{"v":"Analytics and marketing tracking tools are often responsible of more than a third of the requests on websites. Limiting the number of tools and partner would result in less resources use and improve privacy."},null,{"v":"The criterion is validated if:\nTracking is strictly limited to what is necessary, the number of trackers/tools is minimised, and each tracking request is justified. Removing unnecessary trackers reduces network load and improves privacy."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.13"},{"v":"Are the main user jouneys optimised to be smooth and efficient ?"},{"v":"Having efficient user journeys with few screens reduces resources use and improves user satisfaction and productivity."},null,{"v":"The criterion is validated if:\nThe main workflows require a minimal number of steps/screens, with no redundant navigation, improving efficiency and reducing the number of server or client requests."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.14"},{"v":"Are the main screens light and well designed ?"},{"v":"The most used screens must be light in terms of displayed information and media to reduce resources use."},null,{"v":"The criterion is validated if:\nThe most frequently used screens contain only necessary information, use lightweight media, and avoid heavy scripts or components that increase rendering cost."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.15"},{"v":"Is the service frequently used?"},{"v":"A service that is rarely used but continuously running may represent unnecessary environmental impact.\nConversely, a service used frequently justifies its resource consumption.\nUnderstanding usage frequency helps evaluate whether the service should remain as-is, be simplified, be partially decommissioned, or switch to on-demand execution."},null,{"v":"The criterion is validated if the service shows regular, meaningful usage aligned with its resource footprint."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[null,{"v":"1.16"},{"v":"Volume (number of users)"},{"v":"Knowing the number of active users helps contextualise the environmental impact and determine whether the service\u2019s scale matches its actual audience.\nA large infrastructure serving a small population may indicate overprovisioning, while high usage may fully justify the allocated resources."},null,{"v":"The criterion is validated if the product\u2019s user volume justifies its resource usage and architecture."},{"v":"Significant"},null,{"v":0.0,"f":"0"},{"v":1.5,"f":"1,5"},{"v":0.0,"f":"0"},null,{"v":null}]},{"c":[{"v":"License CC-BY-SA"},null,null,null,null,null,null,null,null,null,null,null,{"v":null}]}],"parsedNumHeaders":1}});